# Telegram Ads MCP configuration. Copy to .env and load explicitly:
#   node --env-file=.env dist/cli.js serve
# The server never reads .env files on its own.

# Required. Create a token at https://ads.telegram.org/account/api
TELEGRAM_ADS_TOKEN=

# read-only (default) or write. Write tools also require confirm: true per call.
TG_ADS_MODE=read-only

# off, read-only (default) or write. Controls the tg_execute sandbox.
TG_ADS_CODE_MODE=read-only

# Optional comma-separated allowlist for explicit account_id values.
# TG_ADS_ALLOWED_ACCOUNTS=

# Optional per-call caps in the account currency.
# TG_ADS_MAX_CPM=
# TG_ADS_MAX_AD_BUDGET=
# TG_ADS_MAX_DAILY_BUDGET=

# Optional JSONL audit log. Parent directories are created automatically.
# TG_ADS_AUDIT_LOG=./logs/telegram-ads.jsonl

# Optional request timeout in milliseconds (default: 30000).
# TG_ADS_TIMEOUT_MS=30000

# Do not change this outside of tests. The token is sent to this URL.
# TG_ADS_BASE_URL=https://promoteapi.telegram.org
